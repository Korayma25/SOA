<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://uta.edu.ec/vehiculos"
    xmlns:tns="http://uta.edu.ec/vehiculos"
    elementFormDefault="qualified">

  <xsd:simpleType name="EstadoVehiculoType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DISPONIBLE"/>
      <xsd:enumeration value="VENDIDO"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="ChasisType">
    <xsd:restriction base="xsd:string">
      <xsd:length value="17"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="AnioVehiculoType">
    <xsd:restriction base="xsd:int">
      <xsd:minInclusive value="1900"/>
      <xsd:maxInclusive value="2100"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="PrecioType">
    <xsd:restriction base="xsd:decimal">
      <xsd:minExclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:complexType name="VehiculoType">
    <xsd:sequence>
      <xsd:element name="idVehiculo" type="xsd:int" minOccurs="0"/>
      <xsd:element name="marca" type="xsd:string"/>
      <xsd:element name="modelo" type="xsd:string"/>
      <xsd:element name="placa" type="xsd:string"/>
      <xsd:element name="chasis" type="tns:ChasisType"/>
      <xsd:element name="anio" type="tns:AnioVehiculoType"/>
      <xsd:element name="color" type="xsd:string" minOccurs="0"/>
      <xsd:element name="precio" type="tns:PrecioType"/>
      <xsd:element name="estado" type="tns:EstadoVehiculoType" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="ListaVehiculosType">
    <xsd:sequence>
      <xsd:element name="vehiculo" type="tns:VehiculoType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="ServicioFaultType">
    <xsd:sequence>
      <xsd:element name="codigo" type="xsd:string"/>
      <xsd:element name="mensaje" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:element name="ListarVehiculosRequest" type="xsd:anyType"/>
  <xsd:element name="ListarVehiculosResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculos" type="tns:ListaVehiculosType"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="BuscarVehiculoRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="idVehiculo" type="xsd:int"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="BuscarVehiculoResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculo" type="tns:VehiculoType"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="BuscarVehiculosPorMarcaRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="marca" type="xsd:string"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="BuscarVehiculosPorMarcaResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculos" type="tns:ListaVehiculosType"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="CrearVehiculoRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculo" type="tns:VehiculoType"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="CrearVehiculoResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculo" type="tns:VehiculoType"/>
      <xsd:element name="mensaje" type="xsd:string"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="ActualizarVehiculoRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="idVehiculo" type="xsd:int"/>
      <xsd:element name="vehiculo" type="tns:VehiculoType"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="ActualizarVehiculoResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="vehiculo" type="tns:VehiculoType"/>
      <xsd:element name="mensaje" type="xsd:string"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="EliminarVehiculoRequest">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="idVehiculo" type="xsd:int"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>
  <xsd:element name="EliminarVehiculoResponse">
    <xsd:complexType><xsd:sequence>
      <xsd:element name="success" type="xsd:boolean"/>
      <xsd:element name="mensaje" type="xsd:string"/>
    </xsd:sequence></xsd:complexType>
  </xsd:element>

  <xsd:element name="ServicioFault" type="tns:ServicioFaultType"/>
</xsd:schema>